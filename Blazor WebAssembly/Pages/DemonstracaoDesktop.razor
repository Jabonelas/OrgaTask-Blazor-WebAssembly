@page "/demonstracao-desktop"
@inject NavigationManager Navigation
@inject NotificacaoService notificacaoService

<PageTitle>OrgaTask - Demonstração Desktop</PageTitle>

<div class="container-fluid p-4" style="background-color: #F4F9FC; min-height: 100vh;">

    <h1 class="main-title" style="color: #009DE0">
        <i class="fas fa-desktop mr-2"></i> Demonstração da Versão Desktop
    </h1>

    <!-- Seção do Vídeo -->
    <div class="card shadow-sm border-0 mb-4" style="border-radius: 15px; background-color: white;">
        <div class="card-body">
            <div class="mb-4">
                <h2 style="color: #009DE0; margin-bottom: 0.5rem;">
                    <i class="fas fa-play-circle" style="color: #009DE0; margin-right: 10px;"></i>Vídeo Demonstrativo
                </h2>
                <small class="text-muted" style="font-size: 0.8rem; display: block;">
                    Veja o OrgaTask em ação na versão Windows Forms
                </small>
            </div>

            <div class="video-container" style="border-radius: 10px; overflow: hidden;">
                <video controls style="width: 100%; background-color: #000;">
                    <source src="@($"{Navigation.BaseUri}video/orgatask-demo.mp4")" type="video/mp4">
                    Seu navegador não suporta vídeos HTML5.
                </video>
            </div>
        </div>
    </div>

    <!-- Recursos Principais -->
    <div class="card shadow-sm border-0 mb-4" style="border-radius: 15px; background-color: white;">
        <div class="card-body">
            <div class="mb-4">
                <h2 style="color: #009DE0; margin-bottom: 0.5rem;">
                    <i class="fas fa-star" style="color: #009DE0; margin-right: 10px;"></i>Recursos Principais
                </h2>
                <small class="text-muted" style="font-size: 0.8rem; display: block;">
                    Conheça as principais funcionalidades da versão desktop
                </small>
            </div>


            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; justify-items: center;">
                <!-- Card Gestão de Tarefas -->
                <div class="feature-card" style="background-color: #F8F9FA; border-radius: 10px; padding: 20px; display: flex; flex-direction: column; align-items: center;">
                    <div class="card-icon text-center mb-3" style="color: #E74C3C;">
                        <i class="fas fa-tasks" style="font-size: 2rem;"></i>
                    </div>
                    <div class="card-content text-center">
                        <h3 style="color: #0A2C44;">Gestão Completa</h3>
                        <p style="color: #666;">Crie, edite e organize tarefas com interface intuitiva</p>
                    </div>
                </div>

                <!-- Card Filtros -->
                <div class="feature-card" style="background-color: #F8F9FA; border-radius: 10px; padding: 20px; display: flex; flex-direction: column; align-items: center;">
                    <div class="card-icon text-center mb-3" style="color: #F39C12;">
                        <i class="fas fa-layer-group" style="font-size: 2rem;"></i>
                    </div>
                    <div class="card-content text-center">
                        <h3 style="color: #0A2C44;">Sistema de categorias</h3>
                        <p style="color: #666;">Organize por projetos, prioridades ou tipos</p>
                    </div>
                </div>

                <!-- Card Disponivel -->
                <div class="feature-card" style="background-color: #F8F9FA; border-radius: 10px; padding: 20px; display: flex; flex-direction: column; align-items: center;">
                    <div class="card-icon mb-3" style="color: #2ECC71;">
                        <i class="fas fa-chart-bar" style="font-size: 2rem;"></i>
                    </div>
                    <div class="card-content" style="text-align: center;">
                        <h3 style="color: #0A2C44; margin: 0 0 8px 0;">Progresso</h3>
                        <p style="color: #666; margin: 0;">Visualize seu progresso e produtividade</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Download e Código Fonte -->
    <div class="card shadow-sm border-0 mb-4" style="border-radius: 15px; background-color: white;">
        <div class="card-body">
            <!-- Cabeçalho -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="d-flex align-items-center">
                    <i class="fas fa-download" style="color: #009DE0; font-size: 1.5rem; margin-right: 12px;"></i>
                    <h2 style="color: #009DE0; font-weight: 600; margin-bottom: 0;">Obter a Versão Desktop</h2>
                </div>
                <span class="badge" style="background-color: #009DE0; color: white; border-radius: 10px; padding: 6px 12px; font-size: 0.9rem;">
                    Windows Forms
                </span>
            </div>

            <!-- Seção de Download Principal -->
            <div class="download-platforms mb-4" style="display: grid; grid-template-columns: 1fr; gap: 15px;">
                <!-- Card de Download Desktop -->
                <div style="background-color: #F8F9FA; border-radius: 10px; padding: 20px; display: flex; justify-content: space-between; align-items: center;">
                    <div style="display: flex; align-items: center; gap: 15px;">
                        <i class="fas fa-download" style="color: #009DE0; font-size: 1.5rem;"></i>
                        <div>
                            <h3 style="color: #0A2C44; margin: 0 0 5px 0;">Quer ainda mais flexibilidade?</h3>
                            <p style="color: #666; margin: 0;">Experimente também a versão desktop para seu computador</p>
                        </div>
                    </div>
                    <button @onclick="BaixarVersaoDesktopAsync"
                            style="background-color: #009DE0; color: white; border: none; border-radius: 6px; padding: 10px 20px; font-weight: 500; cursor: pointer; transition: all 0.3s;"
                            onmouseover="this.style.opacity='0.9'"
                            onmouseout="this.style.opacity='1'">
                        <i class="fas fa-download mr-2"></i> Baixar
                    </button>
                </div>

                <!-- Card de Código Fonte -->
                <div style="background-color: #F8F9FA; border-radius: 10px; padding: 20px; display: flex; justify-content: space-between; align-items: center;">
                    <div style="display: flex; align-items: center; gap: 15px;">
                        <i class="fas fa-code" style="color: #009DE0; font-size: 1.5rem;"></i>
                        <div>
                            <h3 style="color: #0A2C44; margin: 0 0 5px 0;">Código Fonte</h3>
                            <p style="color: #666; margin: 0;">O projeto está disponível no GitHub</p>
                        </div>
                    </div>
                    <a href="https://github.com/Jabonelas/OrgaTask-Windows-Forms"
                       style="background-color: #009DE0; color: white; border: none; border-radius: 6px; padding: 10px 20px; text-decoration: none; font-weight: 500; display: inline-flex; align-items: center; transition: all 0.3s;"
                       onmouseover="this.style.opacity='0.9'"
                       onmouseout="this.style.opacity='1'"
                       target="_blank">
                        <i class="fab fa-github mr-2"></i> Ver Código
                    </a>
                </div>
            </div>

            <!-- Mensagem Adicional -->
            <div style="background-color: #E1F5FE; border-radius: 8px; padding: 15px; text-align: center;">
                <p style="color: #0A2C44; margin: 0; font-size: 0.95rem;">
                    <i class="fas fa-desktop mr-2" style="color: #009DE0;"></i>
                    Versão completa para uso no computador com todos os recursos
                </p>
            </div>
        </div>
    </div>
</div>


@code {
    private string GetVideoPath(string videoName)
    {
        return $"{Navigation.BaseUri}media/{videoName}";
    }

    private async Task BaixarVersaoDesktopAsync()
    {

        bool confirmado = await notificacaoService.MostrarConfirmacao("Atenção!",

         "Deseja baixar a versão para desktop do OrgaTask?");



        if (confirmado)
        {
            Navigation.NavigateTo("https://github.com/Jabonelas/OrgaTask-Windows-Forms/releases/download/v1.0.0/OrgaTask.Setup.exe", true);
        }
    }
}